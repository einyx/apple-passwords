{
  "app-id": "org.icp.passwords",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "icp-gui",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--talk-name=org.freedesktop.secrets",
    "--share=network",
    "--talk-name=org.freedesktop.Notifications"
  ],
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable//26.08"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/apple-passwords/cargo",
      "RUST_BACKTRACE": "1"
    }
  },
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/share/man",
    "/share/doc",
    "/share/gtk-doc",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "apple-passwords",
      "buildsystem": "simple",
      "build-commands": [
        "cargo vendor --locked vendor",
        "cargo build --release --locked --offline",
        "install -Dm755 target/release/icp-gui /app/bin/icp-gui",
        "install -Dm755 target/release/icp-cli /app/bin/icp-cli",
        "install -Dm755 target/release/icp-host /app/bin/icp-host",
        "install -Dm644 crates/icp-gui/icons/org.icp.passwords.svg /app/share/icons/hicolor/scalable/apps/org.icp.passwords.svg",
        "install -Dm644 crates/icp-gui/data/org.icp.passwords.desktop /app/share/applications/org.icp.passwords.desktop"
      ],
      "sources": [
        {
          "type": "dir",
          "path": ".."
        }
      ]
    }
  ]
}