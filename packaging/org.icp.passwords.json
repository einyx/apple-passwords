{
  "app-id": "org.icp.passwords",
  "runtime": "org.gnome.Platform",
  "runtime-version": "49",
  "sdk": "org.gnome.Sdk",
  "command": "icp-gui",
  "finish-args": [
    "--filesystem=xdg-config/icp",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--talk-name=org.freedesktop.secrets",
    "--share=network",
    "--talk-name=org.freedesktop.Notifications"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/share/man",
    "/share/doc",
    "/share/gtk-doc",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "apple-passwords",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 staging/icp-gui /app/bin/icp-gui",
        "install -Dm755 staging/icp-cli /app/bin/icp-cli",
        "install -Dm755 staging/icp-host /app/bin/icp-host",
        "install -Dm644 crates/icp-gui/icons/org.icp.passwords.svg /app/share/icons/hicolor/scalable/apps/org.icp.passwords.svg",
        "install -Dm644 crates/icp-gui/data/org.icp.passwords.desktop /app/share/applications/org.icp.passwords.desktop",
        "install -Dm644 packaging/org.icp.passwords.metainfo.xml /app/share/metainfo/org.icp.passwords.metainfo.xml"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "skip": [
            "target",
            ".git",
            "flatpak-repo"
          ]
        }
      ]
    }
  ]
}